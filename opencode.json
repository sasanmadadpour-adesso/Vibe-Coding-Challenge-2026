{​
  "$schema": "https://opencode.ai/config.json",​
  "provider": {​
    "adesso-ai-hub": {​
      "npm": "@ai-sdk/openai-compatible",​
      "name": "adesso AI Hub",​
      "options": { "baseURL": "<AI-HUB-ENDPOINT>" },​
      "models": {​
        "gpt-5.6-sol": {},​
        "claude-opus-5": {},​
        "gpt-5.6-luna": {},​
